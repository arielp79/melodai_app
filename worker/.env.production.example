# Worker en RunPod / VM GPU (ver docs/RUNPOD_WORKER.md y worker/Dockerfile)
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_SEPARATION_QUEUE=melodai:separation:jobs
ORCHESTRATOR_URL=https://melodai-orchestrator.onrender.com
WORKER_API_KEY=mismo-secreto-que-en-render
# Opción A: JSON en una línea (RunPod env)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opción B: archivo montado en el contenedor
GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json
# Opción C: VM en GCP con cuenta de servicio adjunta (sin JSON)
GCS_USE_ADC=true
DEMUCS_ENABLED=true
DEMUCS_MODEL=htdemucs_6s
DEMUCS_DEVICE=cuda
DEMUCS_FALLBACK_STUB=false
