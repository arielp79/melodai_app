# Redis (Upstash: copia la URL "Redis" con rediss://)
REDIS_URL=
REDIS_SEPARATION_QUEUE=melodai:separation:jobs

# Orquestador Node (misma clave que backend/.env)
ORCHESTRATOR_URL=http://127.0.0.1:3000
WORKER_API_KEY=dev-worker-key-change-me

# Misma cuenta de servicio que backend/ (descarga del mix en GCS)
GOOGLE_APPLICATION_CREDENTIALS=../backend/service-account.json

# HTDemucs — htdemucs_6s = 5 pistas PRD (voz, bajo, batería, guitarra, piano)
DEMUCS_ENABLED=true
DEMUCS_MODEL=htdemucs_6s
DEMUCS_DEVICE=cpu
# cuda si tienes NVIDIA + CUDA; cpu es lento pero funciona en Windows
DEMUCS_FALLBACK_STUB=false

WORKER_STUB_DELAY_MS=8000
