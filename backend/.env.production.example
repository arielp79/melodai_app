# Plantilla producción — configurar en Cloud Run / Render (secretos), nunca en git.
PORT=8080
NODE_ENV=production

FIREBASE_PROJECT_ID=melodaiapp
FIREBASE_WEB_API_KEY=
GCS_BUCKET_NAME=melodaiapp.firebasestorage.app
# En Cloud Run: vacío + cuenta de servicio del servicio con Storage Object Admin
GOOGLE_APPLICATION_CREDENTIALS=

# MongoDB Atlas (obligatorio en prod)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=melodai

# CORS: orígenes de tu app (web). Apps nativas no usan CORS.
CORS_ORIGIN=https://tu-dominio.com

AUTH_DISABLED=false

# Upstash / Memorystore / Redis Cloud
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_SEPARATION_QUEUE=melodai:separation:jobs
SEPARATION_WORKER_MODE=redis
SEPARATION_REDIS_FALLBACK_STUB=false
WORKER_API_KEY=genera-un-secreto-largo-aleatorio

# URL pública del orquestador (la usa el worker Python / RunPod)
ORCHESTRATOR_PUBLIC_URL=https://TU-SERVICIO.run.app

# Fase 2 — señal opcional de pre-calentamiento GPU (RunPod autoscaler)
REDIS_GPU_WARMUP_CHANNEL=melodai:gpu:warmup

PRESIGN_EXPIRES_MINUTES=15
MAX_UPLOAD_BYTES=524288000
