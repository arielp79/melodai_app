PORT=3000

# Firebase / Google Cloud (mismo proyecto que Flutter)
FIREBASE_PROJECT_ID=melodaiapp
# Web API Key (Firebase Console → Configuración → General → Tu app Web)
FIREBASE_WEB_API_KEY=
# Vacío = autodetecta melodaiapp.appspot.com o .firebasestorage.app
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# MongoDB Atlas (opcional en local: sin URI usa caché en memoria)
MONGODB_URI=
MONGODB_DB=melodai

# CORS (Flutter Windows: http://127.0.0.1 es irrelevante para app nativa)
CORS_ORIGIN=*

# Solo desarrollo: omitir verificación de token (NO usar en producción)
AUTH_DISABLED=false

# Separación — stub en Node si no hay REDIS_URL; redis = cola + worker Python
# SEPARATION_WORKER_MODE=stub
# SEPARATION_WORKER_MODE=redis
REDIS_URL=
REDIS_SEPARATION_QUEUE=melodai:separation:jobs
WORKER_API_KEY=dev-worker-key-change-me
ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:3000
SEPARATION_REDIS_FALLBACK_STUB=true
SEPARATION_STUB_DELAY_MS=8000
